# Harness identity
HARNESS_ID=h1
HARNESS_VERSION=1.0.0
GIT_COMMIT=unknown
HARNESS_IMPLEMENTATION=python

# Model endpoint. Use an OpenAI-compatible /v1 base URL.
LLM_BASE_URL=http://127.0.0.1:4010/v1
LLM_API_KEY=mock-key
LLM_MODEL=mock/clinical-coder
LLM_TIMEOUT_S=90
LLM_MAX_RETRIES=3
LLM_MAX_CONCURRENCY=4
LLM_RPM=60
LLM_JSON_MODE=false
LLM_PRICES_FILE=
LLM_PRICE_INPUT_PER_MTOK=
LLM_PRICE_OUTPUT_PER_MTOK=

# Per-request ceilings. Requests can lower these, never raise them.
SERVER_MAX_LLM_CALLS=8
SERVER_MAX_INPUT_TOKENS=60000
SERVER_MAX_OUTPUT_TOKENS=8000
SERVER_MAX_TOTAL_TOKENS=80000
SERVER_MAX_WALL_SECONDS=180
SERVER_MAX_COST_USD=1.00
MAX_CODES=50
MAX_RAW_OUTPUT_CHARS=100000

# Guardrails. Keep ALLOW_PHI=false outside an approved deployment.
ALLOW_PHI=false
ALLOW_PROMPT_INJECTION=false
GUARDRAIL_STRICT=false
MAX_NOTE_CHARS=50000
MAX_HISTORY_CHARS=100000
MAX_PROMPT_CHARS=20000

# Hermes (H1 only)
HERMES_BIN=hermes
HERMES_MAX_TURNS=16
HERMES_MODEL_PROVIDER=harness
HERMES_CONTEXT_LENGTH=200000
HERMES_HOME_ROOT=/tmp/clinical-coder-hermes
HERMES_SKILL=icd-cpt-coding
HERMES_KEEP_WORKDIR=false
REQUEST_TIMEOUT_S=240
HERMES_VERSION_CACHE_S=300

# Redis worker mode
REDIS_URL=redis://127.0.0.1:6379/0
COMPARISON_ID=local
HARNESS_SLOT=h1
STREAM_JOBS=cc:jobs:local:h1
STREAM_RESULTS=cc:results:local
CONSUMER_GROUP=workers
WORKER_CONCURRENCY=1
WORKER_HEARTBEAT_S=5

# API / UI
API_HOST=0.0.0.0
API_PORT=8080
LOG_LEVEL=INFO
CORS_ORIGINS=
